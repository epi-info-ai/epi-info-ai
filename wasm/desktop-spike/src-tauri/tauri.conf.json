{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Epi Info AI Desktop Spike",
  "version": "0.2.0",
  "identifier": "gov.cdc.epi-info-ai.desktop-spike",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Epi Info AI Desktop Spike",
        "width": 1440,
        "height": 960,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [],
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "category": "Education",
    "copyright": "Copyright Epi Info AI contributors",
    "shortDescription": "Experimental desktop shell for Epi Info AI",
    "longDescription": "CI-built engineering spike embedding the browser-first Epi Info AI application.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
