  "programs": [
    {
      "name": "recordlink-command-tour",
      "language": "classic-analysis",
      "author": "Epi Info AI",
      "comment": "Synthetic teaching workflow; V0.2 runs aggregate candidate diagnostics only.",
      "createdAt": "2026-09-16T12:00:00.000Z",
      "modifiedAt": "2026-09-16T12:00:00.000Z",
      "source": "*** Epi Info AI RECORDLINK end-to-end command tour\n*** Datasets: patient-registry-a.csv and surveillance-b.csv (entirely synthetic)\n*** Purpose: inspect both sources before proposing cross-source patient links.\n*** New branch; not the legacy matched case-control MATCH command.\n*** V0.2 executes aggregate candidate diagnostics but no comparison or linkage.\n\nHEADER 1 \"Synthetic patient record-linkage teaching workflow\"\nTYPEOUT \"Two fictional eight-record sources use different schemas and contain five known truth links.\"\nTYPEOUT \"Review source quality and aggregate distributions before evaluating any proposed link.\"\n\nREAD patient_registry_a\nHEADER 1 \"Source A - synthetic patient registry\"\nEPIAI QUALITY *\nLIST record_id date_of_birth sex art_code facility_code first_name last_name patient_address\nFREQ facility_code\nFREQ sex\nTABLES facility_code sex\n\nREAD surveillance_b\nHEADER 1 \"Source B - synthetic surveillance line list\"\nEPIAI QUALITY *\nLIST client_id DOB SEX ART_CODE site_code given_name family_name Address\nFREQ site_code\nFREQ SEX\nTABLES site_code SEX\n\nHEADER 1 \"Reviewed cross-source linkage plan\"\nTYPEOUT \"Block on facility/site; compare date, sex, and ART code exactly; compare names and address fuzzily.\"\nEPIAI RECORDLINK SOURCEA=patient_registry_a SOURCEB=surveillance_b IDA=record_id IDB=client_id TRUTH=true_links TRUTHA=source_a_id TRUTHB=source_b_id BLOCK=facility_code:site_code EXACT=date_of_birth:DOB,sex:SEX,art_code:ART_CODE FUZZY=first_name:given_name,last_name:family_name,patient_address:Address FUZZYTHRESHOLD=0.85 REVIEWTHRESHOLD=4 MATCHTHRESHOLD=6 MAXCANDIDATES=10000 RESULT=PatientLinks\n\n*** Future governed slices continue with explainable scores,\n*** clerical review, conflict-aware person clusters, and an explicitly reviewed MERGE."
    }
  ],
  "codeTables": [],
  "runbooks": [
    {
      "id": "recordlink-project-tour",
      "title": "Governed record-linkage project tour",
      "description": "Inspect both synthetic sources, run quality checks, and review aggregate candidate diagnostics without merging records.",
      "prerequisite": "Import the Synthetic Patient Record Linkage example project. It includes two source tables, five known truth links, and a saved command tour.",
      "module": "classic",
      "steps": [
        {
          "id": "orient",
          "title": "Confirm the governed boundary",
          "instruction": "The project contains two fictional eight-record sources and a five-link truth table. No comparison, classification, or merge runs automatically.",
          "target": "#classic-program-title"
        },
        {
          "id": "open-program-dialog",
          "title": "Open the saved linkage workflow",
          "instruction": "Select Open Pgm. The complete workflow is stored with the project.",
          "target": "#classic-program-toolbar-open",
          "advanceOn": "click"
        },
        {
          "id": "load-source",
          "title": "Load visible linkage source",
          "instruction": "Choose recordlink-command-tour and select Open. Loading the program does not execute it.",
          "target": "#classic-program-dialog-primary",
          "advanceOn": "click"
        },
        {
          "id": "verify",
          "title": "Verify the workflow",
          "instruction": "Select Verify Program. Review the QUALITY, LIST, FREQ, TABLES, and governed EPIAI RECORDLINK commands before execution.",
          "target": "#classic-program-verify",
          "advanceOn": "click"
        },
        {
          "id": "run",
          "title": "Run reviewed diagnostics",
          "instruction": "Select Run Commands. The current slice produces aggregate candidate diagnostics only and cannot mutate either source.",
          "target": "#classic-program-run",
          "advanceOn": "click"
        },
        {
          "id": "review-output",
          "title": "Review candidate reduction",
          "instruction": "Inspect the progressive blocking counts, reduction from the full pair space, and truth-link recall. Pair identities and patient values remain out of Output and history.",
          "target": "#classic-recordlink-output"
        },
        {
          "id": "history",
          "title": "Inspect the audit history",
          "instruction": "Open History to confirm the source, plan version, status, and aggregate result summary.",
          "target": "#classic-output-history",
          "advanceOn": "click"
        }
      ]
    }
  ]
