  "programs": [
    {
      "name": "environmental-heat-health-tour",
      "source": "*** Epi Info AI environmental epidemiology teaching candidate\n*** All records and exposure values are synthetic. This program does not estimate causality.\n\nHEADER 1 \"Environmental heat and health teaching workflow\"\nTYPEOUT \"Review data quality, describe the synthetic exposure, compare health-event counts, and open the project point layer in Maps.\"\n\nREAD [Synthetic Heat Health Observations Form]\nEPIAI QUALITY *\nLIST observation_id observation_date study_area heat_index_c extreme_heat health_event\nFREQ heat_category\nMEANS heat_index_c\nTABLES extreme_heat health_event\nGRAPH heat_category GRAPHTYPE=\"Bar\" TITLETEXT=\"Synthetic observations by heat category\" XTITLE=\"Heat category\" YTITLE=\"Observations\"\n\nTYPEOUT \"These descriptive results demonstrate a governed workflow; they are not an exposure model or health-effect estimate.\"\n",
      "language": "classic-analysis",
      "author": "Epi Info AI",
      "comment": "Synthetic quality, descriptive analysis, 2 x 2, chart, GIS-kernel, and map teaching workflow.",
      "createdAt": "2026-09-16T12:00:00.000Z",
      "modifiedAt": "2026-09-16T12:00:00.000Z"
    }
  ],
