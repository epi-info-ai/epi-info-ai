  "programs": [
    {
      "name": "space-time-cluster-command-tour",
      "source": "EPIAI CLUSTER SPACE_TIME ID=case_id DATE=event_date LATITUDE=latitude LONGITUDE=longitude RESULT=FeverRashClusters START=2026-01-01 END=2026-01-28 UNIT=DAY LENGTH=1 MAXDISTANCEKM=5 MAXCASEFRACTION=0.5 MAXTIMEUNITS=7 MAXTIMEFRACTION=0.5 REPLICATIONS=999 SEED=20260916\n\nEPIAI CLUSTER RENDER RESULT=FeverRashClusters",
      "language": "classic-analysis",
      "author": "Epi Info AI",
      "comment": "Runs the bounded case-only space-time permutation candidate with a planted five-day cluster, deterministic seed, Worker progress, cancellation, aggregate-only Output, and an inline result map.",
      "createdAt": "2026-09-16T12:00:00.000Z",
      "modifiedAt": "2026-09-16T12:00:00.000Z"
    },
    {
